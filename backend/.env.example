# WisePay Environment Configuration Example

# Database Connection
# PostgreSQL (Default production & local development)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wisepay

# SQLite Fallback (For offline testing)
# DATABASE_URL=sqlite:///./sentinel.db

# Security & JWT Auth
SECRET_KEY=wisepay-secure-hackathon-jwt-secret-key-2026-32chars-min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Environment
ENVIRONMENT=development

# Microsoft Azure AI Document Intelligence (Free F0 Tier: 500 pages/month)
# Get your free key & endpoint from Azure Portal -> Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here
