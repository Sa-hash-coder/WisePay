# WisePay Environment Configuration Example

# Database Connection
# PostgreSQL (Default production & local development)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wisepay

# SQLite Fallback (For offline testing)
# DATABASE_URL=sqlite:///./sentinel.db

# Security & JWT Auth
SECRET_KEY=wisepay-secure-hackathon-jwt-secret-key-2026-32chars-min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Environment
ENVIRONMENT=development
